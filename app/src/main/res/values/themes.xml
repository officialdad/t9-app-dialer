<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Dialog" parent="Theme.Material3.Dark.Dialog">
        <!-- Transparent window background to show dimmed background -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorSurface">@color/black_pure</item>
        <item name="android:colorBackground">@color/black_pure</item>

        <!-- Dialog configuration -->
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowMinWidthMajor">320dp</item>
        <item name="android:windowMinWidthMinor">320dp</item>
        <item name="android:windowNoTitle">true</item>

        <!-- Rounded corners -->
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.RoundedCorners</item>
    </style>

    <style name="ShapeAppearance.App.RoundedCorners" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Dark Theme AlertDialog Style -->
    <style name="Theme.App.AlertDialog.Dark" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="android:background">@color/dark_dialog_background</item>
        <item name="android:textColor">@color/dark_dialog_text</item>
        <item name="android:textColorPrimary">@color/dark_dialog_text</item>
        <item name="android:textColorSecondary">@color/dark_dialog_text</item>
        <item name="colorPrimary">@color/dark_dialog_button</item>
        <item name="colorAccent">@color/dark_dialog_button</item>
        <item name="android:windowBackground">@color/dark_dialog_background</item>
        <item name="dialogCornerRadius">16dp</item>
    </style>

    <!-- Light Theme AlertDialog Style -->
    <style name="Theme.App.AlertDialog.Light" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="android:background">@color/light_dialog_background</item>
        <item name="android:textColor">@color/light_dialog_text</item>
        <item name="android:textColorPrimary">@color/light_dialog_text</item>
        <item name="android:textColorSecondary">@color/light_dialog_text</item>
        <item name="colorPrimary">@color/light_dialog_button</item>
        <item name="colorAccent">@color/light_dialog_button</item>
        <item name="android:windowBackground">@color/light_dialog_background</item>
        <item name="dialogCornerRadius">16dp</item>
    </style>
</resources>
